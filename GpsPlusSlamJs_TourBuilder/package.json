{
  "name": "gps-plus-slam-tour-builder",
  "version": "0.1.0",
  "private": true,
  "description": "TourBuilder: individually runnable component demos for the AR audio tour-guide lab, one folder per component under components/. Component 1 (billboard): a clickable cylindrical billboard sprite that yaws to face the user, plays an audio clip, and shows an in-world transport panel (play/stop + seekable progress bar). Pure logic is framework-free and unit-tested; the Three.js view layer + demo compose it.",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:framework && pnpm run build:osm && vite",
    "build": "pnpm run build:framework && pnpm run build:osm && tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:core",
    "test:core": "pnpm run format && pnpm run lint && pnpm run lint:css && pnpm run check:all && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:unit",
    "test:unit": "pnpm run build:osm && vitest run",
    "test:watch": "vitest",
    "build:framework": "pnpm --filter gps-plus-slam-app-framework run build",
    "build:osm": "pnpm --filter gps-plus-slam-osm run build",
    "format": "prettier --log-level warn --write --ignore-unknown --no-error-on-unmatched-pattern \"src\" \"config\" index.html README.md package.json",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --config config/eslint.config.mjs",
    "lint:css": "stylelint \"**/*.html\" --config config/stylelint.config.mjs --allow-empty-input",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.vitest.json --noEmit",
    "check:dup": "jscpd --config config/.jscpd.json src",
    "check:cycles": "dpdm -T --exit-code circular:1 --no-warning --no-tree ./src/components/*/demo.ts ./src/app/main.ts",
    "check:boundaries": "depcruise -c config/.dependency-cruiser.cjs src",
    "check:deadcode": "pnpm --workspace-root run check:deadcode",
    "check:all": "pnpm run check:dup && pnpm run check:cycles && pnpm run check:boundaries && pnpm run check:deadcode"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@zip.js/zip.js": "^2.11.2",
    "gps-plus-slam-app-framework": "workspace:*",
    "gps-plus-slam-osm": "workspace:*",
    "h3-js": "^4.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "three-html-render": "^0.1.2"
  },
  "devDependencies": {
    "@carlosjeurissen/stylelint-csstree-validator": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vitest/eslint-plugin": "^1.6.17",
    "dependency-cruiser": "^17.4.0",
    "dpdm": "^4.2.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "jscpd": "^4.1.1",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "license": "Apache-2.0"
}
