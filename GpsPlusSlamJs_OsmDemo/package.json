{
  "name": "gps-plus-slam-osm-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo for gps-plus-slam-osm: a Leaflet view of the res-13 affordance grid and its regions, plus a three.js view of the extruded buildings.",
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "build": "pnpm run build:deps && tsc -p tsconfig.json && vite build",
    "build:deps": "pnpm run build:osm && pnpm run build:framework",
    "build:framework": "node ../scripts/build-workspace-package-if-stale.mjs gps-plus-slam-app-framework GpsPlusSlamJs_AppFramework",
    "build:osm": "node ../scripts/build-workspace-package-if-stale.mjs gps-plus-slam-osm GpsPlusSlamJs_Osm",
    "check:all": "pnpm run check:dup && pnpm run check:cycles && pnpm run check:boundaries",
    "check:boundaries": "node ../scripts/test-timing/timed-stage.mjs check:boundaries",
    "check:cycles": "node ../scripts/test-timing/timed-stage.mjs check:cycles",
    "check:dup": "node ../scripts/test-timing/timed-stage.mjs check:dup",
    "dev": "pnpm run build:deps && vite",
    "format": "node ../scripts/test-timing/timed-stage.mjs format",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "node ../scripts/test-timing/timed-stage.mjs lint",
    "lint:css": "node ../scripts/test-timing/timed-stage.mjs lint:css",
    "preview": "vite preview",
    "test": "node ../scripts/test-timing/run-gate.mjs",
    "test:core": "pnpm run format && pnpm run lint && pnpm run lint:css && pnpm run check:all && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:unit",
    "test:e2e": "node ../scripts/test-timing/timed-stage.mjs test:e2e",
    "test:e2e:headed": "playwright test --config playwright-tests/playwright.config.js --headed",
    "test:unit": "node ../scripts/test-timing/timed-stage.mjs test:unit",
    "typecheck": "node ../scripts/test-timing/timed-stage.mjs typecheck",
    "typecheck:tests": "node ../scripts/test-timing/timed-stage.mjs typecheck:tests"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "gps-plus-slam-app-framework": "workspace:*",
    "gps-plus-slam-osm": "workspace:*",
    "h3-js": "^4.5.0",
    "leaflet": "^1.9.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@carlosjeurissen/stylelint-csstree-validator": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.5",
    "@types/three": "^0.184.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^17.4.3",
    "dpdm": "^4.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jscpd": "^4.3.0",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0"
}
