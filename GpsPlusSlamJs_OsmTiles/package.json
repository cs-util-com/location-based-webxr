{
  "name": "gps-plus-slam-osm-tiles",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker `osm-tiles`: a lazy-filling store of OpenStreetMap tiles, one static gzip file per H3 res-7 cell, filled once from the public Overpass servers by a serial queue consumer and then served to every client.",
  "type": "module",
  "scripts": {
    "test": "node ../scripts/test-timing/run-gate.mjs",
    "format": "node ../scripts/test-timing/timed-stage.mjs format",
    "format:check": "prettier --check --ignore-unknown src package.json README.md wrangler.toml",
    "typecheck": "node ../scripts/test-timing/timed-stage.mjs typecheck",
    "test:unit": "node ../scripts/test-timing/timed-stage.mjs test:unit",
    "deploy": "wrangler deploy",
    "build:osm": "node ../scripts/build-workspace-package-if-stale.mjs gps-plus-slam-osm GpsPlusSlamJs_Osm"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "gps-plus-slam-osm": "workspace:*",
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0"
}
