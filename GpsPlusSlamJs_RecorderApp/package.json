{
  "name": "gps-plus-slam-recorder",
  "version": "0.1.0",
  "description": "WebXR/Three.js recorder app for capturing AR sessions with GPS data for the GpsPlusSlamJs library.",
  "type": "module",
  "files": [
    "index.html",
    "styles/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm run build:framework && vite --config config/vite.config.ts",
    "build": "pnpm run build:framework && tsc && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "node ../scripts/test-timing/run-gate.mjs",
    "test:core": "pnpm run format && pnpm run lint && pnpm run lint:css && pnpm run check:all && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:unit",
    "test:unit": "node ../scripts/test-timing/timed-stage.mjs test:unit",
    "test:watch": "vitest --config config/vitest.config.ts",
    "bench": "vitest bench --run --config config/vitest.bench.config.ts",
    "bench:watch": "vitest bench --config config/vitest.bench.config.ts",
    "build:framework": "node ../scripts/build-workspace-package-if-stale.mjs gps-plus-slam-app-framework GpsPlusSlamJs_AppFramework",
    "test:e2e": "pnpm run build:framework && node ../scripts/test-timing/timed-stage.mjs test:e2e",
    "test:e2e:headed": "pnpm run build:framework && playwright test --config playwright-tests/playwright.config.js --headed",
    "test:e2e:ui": "pnpm run build:framework && playwright test --config playwright-tests/playwright.config.js --ui",
    "format": "node ../scripts/test-timing/timed-stage.mjs format",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "node ../scripts/test-timing/timed-stage.mjs lint",
    "lint:css": "node ../scripts/test-timing/timed-stage.mjs lint:css",
    "typecheck": "node ../scripts/test-timing/timed-stage.mjs typecheck",
    "typecheck:tests": "node ../scripts/test-timing/timed-stage.mjs typecheck:tests",
    "check:dup": "node ../scripts/test-timing/timed-stage.mjs check:dup",
    "check:cycles": "node ../scripts/test-timing/timed-stage.mjs check:cycles",
    "check:boundaries": "node ../scripts/test-timing/timed-stage.mjs check:boundaries",
    "check:all": "pnpm run check:dup && pnpm run check:cycles && pnpm run check:boundaries",
    "setup": "bash ./scripts/setup.sh"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/browser": "^10.53.1",
    "@types/leaflet": "^1.9.21",
    "@zip.js/zip.js": "^2.8.26",
    "gps-plus-slam-app-framework": "workspace:*",
    "h3-js": "^4.4.0",
    "leaflet": "^1.9.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@carlosjeurissen/stylelint-csstree-validator": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.7.0",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.17",
    "dependency-cruiser": "^17.4.0",
    "dpdm": "^4.2.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "jscpd": "^4.1.1",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "webxr-polyfill": "^2.0.3"
  },
  "keywords": [
    "webxr",
    "threejs",
    "ar",
    "gps",
    "recorder"
  ],
  "author": "cs-util-com",
  "license": "Apache-2.0"
}
