{
    "name": "location-based-webxr",
    "version": "0.1.0",
    "private": true,
    "description": "Open-source AR+GPS framework and recorder app for location-based WebXR experiences.",
    "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
    "scripts": {
        "build:framework": "pnpm run --filter gps-plus-slam-app-framework... build",
        "build:recorder": "pnpm run --filter gps-plus-slam-recorder... build",
        "build:starter": "pnpm run --filter gps-plus-slam-anchor-starter... build",
        "build:example": "pnpm run --filter gps-plus-slam-minimal-example... build",
        "build:qr-demo": "pnpm run --filter gps-plus-slam-qr-tracking-demo... build",
        "build:landing": "pnpm run --filter gps-plus-slam-landing... build",
        "build:site": "node scripts/build-site.mjs",
        "check:deadcode": "knip",
        "test:repo-config": "vitest run --config vitest.config.js",
        "test:framework": "pnpm --filter gps-plus-slam-app-framework test",
        "test:recorder": "pnpm --filter gps-plus-slam-recorder test",
        "test:recorder:unit": "pnpm --filter gps-plus-slam-recorder run test:unit",
        "test:recorder:e2e": "pnpm --filter gps-plus-slam-recorder run test:e2e",
        "test:starter": "pnpm --filter gps-plus-slam-anchor-starter test",
        "test:example": "pnpm --filter gps-plus-slam-minimal-example test",
        "test:qr-demo": "pnpm --filter gps-plus-slam-qr-tracking-demo test",
        "test:landing": "pnpm --filter gps-plus-slam-landing test",
        "test": "pnpm run test:repo-config && pnpm run test:framework && pnpm run test:recorder && pnpm run test:starter && pnpm run test:example && pnpm run test:qr-demo && pnpm run test:landing"
    },
    "engines": {
        "node": ">=22.14.0"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "fast-check": "^4.8.0",
        "knip": "^6.13.1",
        "vitest": "^4.1.6",
        "yaml": "^2.9.0"
    }
}
