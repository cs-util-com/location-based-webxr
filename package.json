{
    "name": "location-based-webxr",
    "version": "0.1.0",
    "private": true,
    "description": "Open-source AR+GPS framework and recorder app for location-based WebXR experiences.",
    "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
    "scripts": {
        "build:framework": "pnpm run --filter gps-plus-slam-app-framework... build",
        "build:osm": "pnpm run --filter gps-plus-slam-osm... build",
        "build:recorder": "pnpm run --filter gps-plus-slam-recorder... build",
        "build:starter": "pnpm run --filter gps-plus-slam-anchor-starter... build",
        "build:example": "pnpm run --filter gps-plus-slam-minimal-example... build",
        "build:qr-demo": "pnpm run --filter gps-plus-slam-qr-tracking-demo... build",
        "build:tour": "pnpm run --filter gps-plus-slam-tour-viewer... build",
        "build:landing": "pnpm run --filter gps-plus-slam-landing... build",
        "build:site": "node scripts/build-site.mjs",
        "check:deadcode": "node scripts/test-timing/timed-stage.mjs check:deadcode",
        "test:repo-config": "node scripts/test-timing/timed-stage.mjs test:repo-config",
        "test:framework": "node scripts/test-timing/timed-stage.mjs test:framework",
        "test:osm": "node scripts/test-timing/timed-stage.mjs test:osm",
        "test:recorder": "node scripts/test-timing/timed-stage.mjs test:recorder",
        "test:recorder:unit": "pnpm --filter gps-plus-slam-recorder run test:unit",
        "test:recorder:e2e": "pnpm --filter gps-plus-slam-recorder run test:e2e",
        "test:starter": "node scripts/test-timing/timed-stage.mjs test:starter",
        "test:example": "node scripts/test-timing/timed-stage.mjs test:example",
        "test:qr-demo": "node scripts/test-timing/timed-stage.mjs test:qr-demo",
        "test:osm-demo": "node scripts/test-timing/timed-stage.mjs test:osm-demo",
        "test:landing": "node scripts/test-timing/timed-stage.mjs test:landing",
        "test": "node scripts/test-timing/run-gate.mjs",
        "test:physics": "node scripts/test-timing/timed-stage.mjs test:physics",
        "test:wayfinding": "node scripts/test-timing/timed-stage.mjs test:wayfinding",
        "test:tour": "node scripts/test-timing/timed-stage.mjs test:tour",
        "test:site-worker": "node scripts/test-timing/timed-stage.mjs test:site-worker",
        "test:changed": "node scripts/test-changed/test-changed.mjs",
        "deploy:site": "wrangler versions upload"
    },
    "engines": {
        "node": ">=22.15.0"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "fast-check": "^4.8.0",
        "knip": "^6.13.1",
        "vitest": "^4.1.6",
        "wrangler": "^4.126.0",
        "yaml": "^2.9.0"
    }
}
