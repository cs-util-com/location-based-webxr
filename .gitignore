# Root node_modules (created by pnpm workspaces — hoists shared dependencies)
node_modules/

# Combined multi-app deploy output, built in CI by `pnpm run build:site`.
dist-site/

# npm/pnpm auth tokens — must never be committed. Project-level .npmrc files
# may legitimately exist for non-secret config (registry URLs, auto-install-peers),
# but in this repo we keep all auth in ~/.npmrc only and ignore project-level
# .npmrc as defense-in-depth against accidental `npm config set ... --location=project`.
.npmrc
.DS_Store

# Per-developer IDE state (JetBrains) — never commit editor config.
.idea/

# Each gate's own timing tables: local numbers, never versioned, so two branches
# cannot conflict on them. A run on main uploads its tables as an artifact
# (scripts/test-timing/README.md).
docs/test-timings.md
*/docs/test-timings.md

# Scratch file the test-timing gate writes while rewriting docs/test-timings.md.
# A gate interrupted mid-write leaves it behind; it must never be committed
# (2026-07-26: one slipped into a commit this way).
*.md.tmp

# Local-only agent instructions (imports the closed-source rule set)
CLAUDE.local.md
