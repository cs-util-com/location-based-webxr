{
  // Extends the workspace demo-app compiler profile (../tsconfig.demo-base.json
  // — the single source of truth for the strictness flags, simplify loop
  // Area 13). Only the location-dependent bits stay here: `types` (resolved
  // from THIS package's node_modules), the per-project `tsBuildInfoFile`,
  // and `include`/`exclude`.
  "extends": "../tsconfig.demo-base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "coverage",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.property.test.ts"
  ]
}
