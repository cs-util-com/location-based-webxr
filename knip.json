{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "exports": "error",
    "types": "error"
  },
  "workspaces": {
    "GpsPlusSlamJs_Osm": {
      "entry": [
        "src/index.ts",
        "src/model/index.ts",
        "src/source/index.ts",
        "src/spatial/index.ts",
        "config/eslint.config.mjs"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "dpdm"
      ]
    },
    ".": {
      "entry": [
        "tests/**/*.test.js"
      ],
      "project": [
        "tests/**/*.js"
      ]
    },
    "GpsPlusSlamJs_AppFramework": {
      "entry": [
        "src/index.ts",
        "src/ar/index.ts",
        "src/core/index.ts",
        "src/sensors/index.ts",
        "src/state/index.ts",
        "src/storage/index.ts",
        "src/visualization/index.ts",
        "src/utils/index.ts",
        "src/types/index.ts",
        "src/types/global.d.ts",
        "src/types/webxr.d.ts",
        "src/licensing/index.ts",
        "src/test-utils/**/*.ts",
        "src/state/replay-session.ts",
        "src/state/replay-occupancy-subscriber.ts",
        "config/eslint.config.mjs"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "dpdm",
        "redux"
      ]
    },
    "GpsPlusSlamJs_RecorderApp": {
      "entry": [
