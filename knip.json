{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "exports": "error",
    "types": "error"
  },
  "workspaces": {
    "GpsPlusSlamJs_Osm": {
      "entry": [
        "src/index.ts",
        "src/model/index.ts",
        "src/source/index.ts",
        "src/spatial/index.ts",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["dpdm"]
    },
    ".": {
      "entry": ["tests/**/*.test.js"],
      "project": ["tests/**/*.js"]
    },
    "GpsPlusSlamJs_AppFramework": {
      "entry": [
        "src/index.ts",
        "src/ar/index.ts",
        "src/core/index.ts",
        "src/sensors/index.ts",
        "src/state/index.ts",
        "src/storage/index.ts",
        "src/osm-bridge/index.ts",
        "src/visualization/index.ts",
        "src/utils/index.ts",
        "src/types/index.ts",
        "src/types/global.d.ts",
        "src/types/webxr.d.ts",
        "src/licensing/index.ts",
        "src/test-utils/**/*.ts",
        "src/state/replay-session.ts",
        "src/state/replay-occupancy-subscriber.ts",
        "src/utils/escape-html.ts",
        "src/utils/compass-influence-mapping.ts",
        "src/utils/format-distance.ts",
        "src/utils/toast-core.ts",
        "src/ar/qr/qr-mint-level.ts",
        "src/ar/qr/qr-sighting-accumulator.ts",
        "src/ar/qr/qr-anchor-mint.ts",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["dpdm", "redux"]
    },
    "GpsPlusSlamJs_RecorderApp": {
      "entry": [
        "src/global.d.ts",
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard",
        "tailwindcss",
        "webxr-polyfill"
      ]
    },
    "GpsPlusSlamJs_AnchorStarter": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_MinimalExample": {
      "project": ["src/**/*.ts"]
    },
    "GpsPlusSlamJs_OsmDemo": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs",
        "src/worker/demo-worker.ts",
        "src/gallery-main.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreUnresolved": ["/src/ar-compass-control.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_Landing": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs",
        "scripts/blog/build-blog.mjs",
        "scripts/blog/trigger-deploy.mjs",
        "scripts/marketing/drip.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/blog/**/*.mjs",
        "scripts/marketing/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_QrTrackingDemo": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_PhysicsDemo": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_WayfindingHudDemo": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_TourViewer": {
      "entry": [
        "config/stylelint.config.mjs",
        "playwright-tests/**/*.{js,ts}",
        "config/eslint.config.mjs"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "dependency-cruiser",
        "dpdm",
        "jscpd",
        "postcss-html",
        "stylelint-config-standard"
      ]
    },
    "GpsPlusSlamJs_SiteWorker": {
      "entry": ["src/site-worker.ts"],
      "project": ["src/**/*.ts"]
    },
    "GpsPlusSlamJs_DesignSystem": {
      "entry": ["config/stylelint.config.mjs"],
      "project": ["*.mjs", "config/*.mjs"],
      "ignoreDependencies": [
        "@carlosjeurissen/stylelint-csstree-validator",
        "stylelint-config-standard"
      ]
    }
  }
}
