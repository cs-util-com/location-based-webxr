{
  "name": "gps-plus-slam-minimal-example",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal getting-started example consuming gps-plus-slam-app-framework: Three.js scene driven by createSlamAppStore() with NullStorageBackend.",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:framework && vite",
    "build": "pnpm run build:framework && tsc -p tsconfig.json && vite build",
    "build:framework": "pnpm --filter gps-plus-slam-app-framework run build",
    "preview": "vite preview",
    "test": "node ../scripts/test-timing/run-gate.mjs",
    "test:unit": "node ../scripts/test-timing/timed-stage.mjs test:unit",
    "typecheck": "node ../scripts/test-timing/timed-stage.mjs typecheck"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "gps-plus-slam-app-framework": "workspace:*",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/three": "^0.184.1",
    "@types/webxr": "^0.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "license": "Apache-2.0"
}
