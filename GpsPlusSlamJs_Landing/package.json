{
  "name": "gps-plus-slam-landing",
  "version": "0.1.0",
  "private": true,
  "description": "The gps.csutil.com root landing page: a three.js + anime.js scroll-story that explains the Location-based WebXR framework to non-technical decision makers and routes builders to the demo apps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "shoot": "node scripts/shoot-chapters.mjs",
    "test": "node ../scripts/test-timing/run-gate.mjs",
    "test:core": "pnpm run format && pnpm run lint && pnpm run lint:css && pnpm run check:all && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:unit",
    "test:unit": "node ../scripts/test-timing/timed-stage.mjs test:unit",
    "test:watch": "vitest",
    "test:e2e": "node ../scripts/test-timing/timed-stage.mjs test:e2e",
    "format": "node ../scripts/test-timing/timed-stage.mjs format",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "node ../scripts/test-timing/timed-stage.mjs lint",
    "lint:css": "node ../scripts/test-timing/timed-stage.mjs lint:css",
    "typecheck": "node ../scripts/test-timing/timed-stage.mjs typecheck",
    "typecheck:tests": "node ../scripts/test-timing/timed-stage.mjs typecheck:tests",
    "check:dup": "node ../scripts/test-timing/timed-stage.mjs check:dup",
    "check:cycles": "node ../scripts/test-timing/timed-stage.mjs check:cycles",
    "check:boundaries": "node ../scripts/test-timing/timed-stage.mjs check:boundaries",
    "check:all": "pnpm run check:dup && pnpm run check:cycles && pnpm run check:boundaries"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "postprocessing": "^6.39.4",
    "three": "^0.184.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@carlosjeurissen/stylelint-csstree-validator": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.5",
    "@types/three": "^0.184.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^17.4.3",
    "dpdm": "^4.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jscpd": "^4.3.0",
    "marked": "^18.0.11",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0"
}
