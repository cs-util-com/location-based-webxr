{
  // Shared compiler profile for the five demo/consumer apps (AnchorStarter,
  // QrTrackingDemo, PhysicsDemo, WayfindingHudDemo, Landing) — extracted
  // 2026-07-18 from five content-identical tsconfig.app.json files so the
  // strictness profile has ONE source of truth (simplify loop, Area 13).
  //
  // Deliberately contains ONLY location-independent options. Everything whose
  // paths resolve relative to the declaring file stays in each package:
  // `types` (node_modules lookup starts at the declaring config — the vite
  // types live in each package, not at the workspace root), `tsBuildInfoFile`
  // (must be per-project or five builds would share one .tsbuildinfo), and
  // `include`/`exclude`. The library-family packages (AppFramework,
  // RecorderApp, MinimalExample) intentionally do NOT extend this — their
  // profiles differ structurally (module/lib/allowJs/paths).
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true
  }
}
